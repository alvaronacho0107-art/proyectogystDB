<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPanel"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:title="Panel Principal"
        android:titleTextColor="@android:color/white" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/status_in_progress_bg"
                android:padding="20dp"
                android:text="Bienvenido, Administrador\nSistema de Control y Seguimiento de Garantías y Servicios Técnicos."
                android:textColor="@color/blue_primary_dark"
                android:textSize="18sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonClientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Gestionar Clientes" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGarantias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gestionar Garantías" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonServiciosTecnicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gestionar Servicios Técnicos" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCerrarSesion"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Cerrar sesión" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
